# 接口地址。留空表示开发时走 Vite 代理（/api -> http://127.0.0.1:3000，见 vite.config.js）
# 注意：管理后台上传 / 扫描入库的视频和封面存的是站内地址（/media/videos/x.mp4 这种），前端原样使用、
# 不会拼上这里的地址。所以这里指向别的域名 / 端口时（或打包进 Capacitor 等原生壳时），
# 必须让页面所在的域名也能访问 /media/：由接口服务同源托管前端（node server/index.mjs 会托管 dist），
# 或在 Nginx 等反向代理上把 /media/ 转发到接口服务，否则这些视频和封面会加载失败。
VITE_API_BASE=

# auto = 优先接口，连不上退回本地模拟数据；http = 只用接口；mock = 只用模拟数据
VITE_API_MODE=auto
